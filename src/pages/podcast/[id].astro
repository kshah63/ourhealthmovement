---
import Layout from '../../layouts/Layout.astro';
import Botanical from '../../components/Botanical.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const episodes = await getCollection('podcast');
  return episodes.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;

const dateFmt = data.date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const all = (await getCollection('podcast'))
  .filter((e) => e.data.published)
  .sort((a, b) => b.data.episode - a.data.episode);
const idx = all.findIndex((e) => e.id === entry.id);
const next = all[idx - 1]; // newer
const prev = all[idx + 1]; // older
---

<Layout title={`${data.title} — Ep ${data.episode}`} description={data.summary}>
  <article class="episode">
    <header class="ep-hero">
      <div class="wrap">
        <a href="/podcast" class="ep-back">← The Podcast</a>
        <p class="ep-hero__num">Episode {String(data.episode).padStart(2, '0')} · {data.topic}</p>
        <h1 data-reveal>{data.title}</h1>
        <p class="ep-hero__guest" data-reveal style="--delay: 80ms">
          with <strong>{data.guest}</strong> — {data.guestTitle}
        </p>
        <div class="ep-hero__meta" data-reveal style="--delay: 140ms">
          <span>{data.duration}</span><span aria-hidden="true">·</span><span>{dateFmt}</span>
        </div>

        <div class="player" data-reveal style="--delay: 200ms">
          {
            data.audioUrl ? (
              <audio controls preload="none" src={data.audioUrl} class="player__audio">
                Your browser doesn't support audio playback.
              </audio>
            ) : (
              <div class="player__placeholder">
                <span class="player__play" aria-hidden="true">▶</span>
                <div>
                  <strong>Audio coming soon</strong>
                  <span>Add an <code>audioUrl</code> to this episode to embed the player.</span>
                </div>
              </div>
            )
          }
          <div class="player__links">
            <span>Also on</span>
            <a href="#">Apple</a><a href="#">Spotify</a><a href="#">RSS</a>
          </div>
        </div>
      </div>
    </header>

    <div class="wrap ep-body">
      <p class="ep-body__lede">{data.summary}</p>
      <Botanical variant="wave" width={110} class="ep-body__wave" />
      <div class="prose">
        <Content />
      </div>
    </div>

    <nav class="ep-nav">
      <div class="wrap ep-nav__grid">
        {
          prev ? (
            <a href={`/podcast/${prev.id}`} class="ep-nav__link ep-nav__link--prev">
              <span>← Previous</span>
              <strong>{prev.data.title}</strong>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a href={`/podcast/${next.id}`} class="ep-nav__link ep-nav__link--next">
              <span>Next →</span>
              <strong>{next.data.title}</strong>
            </a>
          )
        }
      </div>
    </nav>
  </article>

  <Newsletter />
</Layout>

<style>
  .ep-hero {
    padding-block: clamp(2rem, 5vw, 3.25rem);
    background:
      radial-gradient(80% 120% at 100% 0%, rgba(207, 147, 39, 0.16), transparent 55%),
      var(--forest);
    color: #ece4d3;
  }
  .ep-back {
    display: inline-block;
    font-size: var(--step--1);
    font-weight: 560;
    color: #cbc0a7;
    text-decoration: none;
    margin-bottom: 1.25rem;
  }
  .ep-back:hover {
    color: var(--ochre);
  }
  .ep-hero__num {
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ochre);
    font-weight: 620;
  }
  .ep-hero h1 {
    color: #f4ead6;
    font-size: var(--step-4);
    margin-top: 0.5rem;
    max-width: 22ch;
  }
  .ep-hero__guest {
    margin-top: 1rem;
    color: #cbc0a7;
    font-size: var(--step-1);
  }
  .ep-hero__guest strong {
    color: #f4ead6;
  }
  .ep-hero__meta {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.75rem;
    color: #a89d84;
    font-size: var(--step--1);
  }

  .player {
    margin-top: 2rem;
    max-width: 640px;
  }
  .player__audio {
    width: 100%;
    height: 44px;
  }
  .player__placeholder {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    background: rgba(244, 234, 214, 0.06);
    border: 1px solid rgba(236, 228, 211, 0.16);
    border-radius: 100px;
  }
  .player__play {
    width: 44px;
    height: 44px;
    flex: none;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--ochre);
    color: var(--forest);
    font-size: 0.85rem;
  }
  .player__placeholder strong {
    display: block;
    color: #f4ead6;
  }
  .player__placeholder span {
    font-size: var(--step--1);
    color: #a89d84;
  }
  .player__placeholder code {
    background: rgba(236, 228, 211, 0.12);
    color: #e7dcc4;
    padding: 0.05em 0.35em;
    border-radius: 3px;
  }
  .player__links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
    font-size: var(--step--1);
  }
  .player__links span {
    color: #a89d84;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    font-weight: 620;
  }
  .player__links a {
    color: #e7dcc4;
    text-decoration: none;
    border-bottom: 1px solid rgba(231, 220, 196, 0.4);
  }
  .player__links a:hover {
    color: var(--ochre);
  }

  .ep-body {
    padding-block: clamp(2.5rem, 6vw, 4rem);
    max-width: 760px;
  }
  .ep-body__lede {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-variation-settings: 'opsz' 50, 'SOFT' 40, 'wght' 370;
    line-height: 1.35;
    color: var(--ink);
  }
  .ep-body__wave {
    color: var(--sage);
    margin: 1.75rem 0;
  }

  .ep-nav {
    border-top: 1px solid var(--line);
    background: var(--paper-2);
    padding-block: clamp(1.75rem, 4vw, 2.5rem);
  }
  .ep-nav__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .ep-nav__link {
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .ep-nav__link:hover {
    transform: translateY(-2px);
    border-color: var(--terracotta);
    color: var(--ink);
  }
  .ep-nav__link--next {
    text-align: right;
  }
  .ep-nav__link span {
    display: block;
    font-size: var(--step--1);
    color: var(--terracotta);
    font-weight: 600;
  }
  .ep-nav__link strong {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--font-display);
    font-weight: 460;
    font-size: var(--step-1);
  }

  @media (max-width: 640px) {
    .ep-nav__grid {
      grid-template-columns: 1fr;
    }
    .ep-nav__link--next {
      text-align: left;
    }
  }
</style>
