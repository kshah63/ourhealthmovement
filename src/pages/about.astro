---
import Layout from '../layouts/Layout.astro';
import Botanical from '../components/Botanical.astro';
import BrandMark from '../components/BrandMark.astro';
import Newsletter from '../components/Newsletter.astro';

const values = [
  {
    title: 'Rooted in tradition',
    text: 'We take seriously the knowledge held in Ayurveda, Chinese Medicine, Yoga and other lineages — not as folklore, but as thousands of years of careful observation.',
  },
  {
    title: 'Honest, not dogmatic',
    text: 'We share where ancient practice and modern science agree, and we say so when the evidence is thin. No fear-mongering, no miracle cures, no absolutes.',
  },
  {
    title: 'Small, doable steps',
    text: 'Wellbeing isn’t built on a grand overhaul. It’s a warm breakfast, a walk after dinner, one swap at a time. We keep it practical.',
  },
  {
    title: 'With the seasons',
    text: 'Nature moves in cycles, and so should we. Eating, moving and resting in tune with the season is the thread running through everything here.',
  },
];
---

<Layout
  title="About"
  description="Our Health Movement is a return to older, gentler knowledge about how to live well — bringing Ayurveda, Chinese Medicine and Yoga into modern, everyday life."
>
  <section class="about-hero">
    <div class="about-hero__glow" aria-hidden="true"></div>
    <div class="wrap about-hero__inner">
      <div class="about-hero__mark" data-reveal aria-hidden="true"><BrandMark size={64} /></div>
      <p class="eyebrow centered" data-reveal style="--delay: 60ms">Our Story</p>
      <h1 data-reveal style="--delay: 120ms">A movement back toward<br /><em>older, wiser ways</em></h1>
      <p class="about-hero__lede" data-reveal style="--delay: 200ms">
        We started Our Health Movement from a simple frustration: modern wellness had become
        loud, expensive and complicated — while the wisdom that actually helps people feel
        well has been quietly sitting in ancient traditions all along.
      </p>
    </div>
  </section>

  <section class="section story">
    <div class="wrap-narrow prose story__prose" data-reveal-scroll>
      <p class="story__standfirst">
        For most of human history, health wasn't a product. It was a way of living — woven
        into what you ate, how you moved, when you rested, and your place in the turning of
        the year.
      </p>
      <p>
        Somewhere along the way, we traded a lot of that for convenience. Food arrived
        stripped of its season. Movement became something you scheduled. And a growing haze
        of synthetic fragrances, plastics and additives settled quietly into daily life. We
        gained so much — and mislaid something, too.
      </p>
      <p>
        <strong>Our Health Movement is an attempt to gather it back up.</strong> We look to
        Ayurveda, Traditional Chinese Medicine, Yoga and other enduring traditions — not to
        romanticise the past, but because they hold genuinely useful, time-tested ideas about
        living well. Then we translate them into something you can actually do in a modern
        kitchen, on a modern Tuesday.
      </p>
      <p>
        That means seasonal, local eating. Cooking with spices that double as medicine.
        Moving in ways the body was built for, and breathing in ways that settle the nervous
        system. Clearing out the low-level toxic load of everyday life. And, through the
        podcast, sitting down with the teachers and practitioners keeping this knowledge
        alive.
      </p>
      <blockquote>
        The future of feeling well looks a lot like the past — seasonal, unhurried, and
        deeply connected to the natural world.
      </blockquote>
    </div>
  </section>

  <section class="section values dark">
    <div class="wrap">
      <header class="values__head" data-reveal-scroll>
        <p class="eyebrow">What we believe</p>
        <h2>Four things we hold to</h2>
      </header>
      <div class="values__grid">
        {
          values.map((v, i) => (
            <article class="value" data-reveal-scroll style={`--delay: ${i * 80}ms`}>
              <span class="value__num">0{i + 1}</span>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section join">
    <div class="wrap-narrow" data-reveal-scroll>
      <Botanical variant="sprig" width={48} class="join__sprig" />
      <p class="eyebrow centered">Come along</p>
      <h2>It's called a movement for a reason</h2>
      <p class="join__text">
        This works best as something we do together. Start by wandering the guides, cooking
        something in season, or listening to an episode — and if it resonates, join the
        Seasonal Letter and move through the year with us.
      </p>
      <div class="join__actions">
        <a href="/wisdom" class="btn btn--terracotta">Start with the wisdom <span class="arrow">→</span></a>
        <a href="/eat" class="btn btn--ghost">See what's in season</a>
      </div>
    </div>
  </section>

  <Newsletter />
</Layout>

<style>
  .about-hero {
    position: relative;
    text-align: center;
    padding-block: clamp(3rem, 7vw, 5rem);
    overflow: hidden;
  }
  .about-hero__glow {
    position: absolute;
    top: -30%;
    left: 50%;
    transform: translateX(-50%);
    width: 70%;
    aspect-ratio: 1;
    background: radial-gradient(circle, rgba(207, 147, 39, 0.18), transparent 60%);
    pointer-events: none;
  }
  .about-hero__inner {
    position: relative;
    max-width: 720px;
  }
  .about-hero__mark {
    color: var(--terracotta);
    display: inline-grid;
    place-items: center;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: var(--paper-2);
    box-shadow: inset 0 2px 12px rgba(42, 32, 25, 0.1);
    margin-bottom: 1.5rem;
  }
  .about-hero h1 {
    font-size: var(--step-5);
    margin-top: 0.75rem;
  }
  .about-hero h1 em {
    font-style: italic;
    color: var(--terracotta);
  }
  .about-hero__lede {
    margin: 1.5rem auto 0;
    max-width: 56ch;
    font-size: var(--step-1);
    color: var(--ink-2);
    line-height: 1.5;
  }

  .story__prose {
    font-size: var(--step-1);
  }
  .story__standfirst {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-variation-settings: 'opsz' 60, 'SOFT' 40, 'wght' 370;
    line-height: 1.3;
    color: var(--ink);
  }
  .story__prose strong {
    color: var(--terracotta-deep);
  }

  .values {
    background: linear-gradient(165deg, var(--forest), var(--forest-2));
  }
  .values__head {
    margin-bottom: 2.5rem;
  }
  .values__head h2 {
    margin-top: 0.5rem;
  }
  .values__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }
  .value {
    padding: 1.75rem 1.5rem;
    background: rgba(244, 234, 214, 0.05);
    border: 1px solid rgba(236, 228, 211, 0.14);
    border-top: 3px solid var(--ochre);
    border-radius: var(--radius);
  }
  .value__num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-2);
    color: var(--ochre);
  }
  .value h3 {
    color: #f4ead6;
    font-size: var(--step-1);
    margin: 0.5rem 0 0.6rem;
  }
  .value p {
    color: #c8bda3;
    font-size: var(--step--1);
    line-height: 1.6;
  }

  .join {
    text-align: center;
  }
  .join__sprig {
    color: var(--sage);
    margin: 0 auto 1rem;
  }
  .join h2 {
    margin-top: 0.5rem;
  }
  .join__text {
    margin: 1.25rem auto 1.75rem;
    max-width: 52ch;
    color: var(--ink-2);
    font-size: var(--step-1);
    line-height: 1.55;
  }
  .join__actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 860px) {
    .values__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 480px) {
    .values__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
