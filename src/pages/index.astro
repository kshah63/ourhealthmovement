<script>
  import { seasonForMonth } from '../data/seasonal.ts';
  const current = seasonForMonth(new Date().getMonth(), 'north');
  document.querySelectorAll('[data-season-card]').forEach((el) => {
    if (el.getAttribute('data-season-card') === current) el.classList.add('is-current');
  });
  const titles: Record<string, string> = {
    spring: "It's spring — time to lighten & renew",
    summer: "It's summer — time to cool & hydrate",
    autumn: "It's autumn — time to ground & gather",
    winter: "It's winter — time to warm & restore",
  };
  const titleEl = document.querySelector('[data-season-title]');
  if (titleEl && titles[current]) titleEl.textContent = titles[current];
</script>
