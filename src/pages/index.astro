---
import Layout from '../layouts/Layout.astro';
import Newsletter from '../components/Newsletter.astro';
import Botanical from '../components/Botanical.astro';
import BrandMark from '../components/BrandMark.astro';
import { getCollection } from 'astro:content';
import { seasons } from '../data/seasonal.ts';

const wisdom = (await getCollection('wisdom')).sort((a, b) => a.data.order - b.data.order);

const guideRoutes = [
  {
    label: 'The Spice Cabinet',
    href: '/guides/spices',
    blurb: 'Turmeric, ginger, cinnamon & more, how to use them, and why they matter.',
    accent: 'ochre',
  },
  {
    label: 'Fruit & Veg',
    href: '/guides/produce',
    blurb: 'What to eat, and when, a season-by-season guide to eating local.',
    accent: 'sage',
  },
  {
    label: 'Low-Tox Swaps',
    href: '/guides/low-tox',
    blurb: 'Small, simple changes at home that quietly lower your daily exposure.',
    accent: 'clay',
  },
];

---

<Layout>
  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="eyebrow" data-reveal style="--delay: 0ms">Ayurveda · Chinese Medicine · Yoga</p>
        <h1 data-reveal style="--delay: 90ms">
          Ancient wisdom,<br />
          for a <em>modern</em> life.
        </h1>
        <p class="hero__lede" data-reveal style="--delay: 200ms">
          A slower, wiser way to look after yourself, drawing on traditions thousands of
          years old, and translating them into how we eat, move and live with the seasons
          today.
        </p>
        <div class="hero__actions" data-reveal style="--delay: 300ms">
          <a href="/wisdom" class="btn btn--terracotta">Explore the wisdom <span class="arrow">→</span></a>
          <a href="/eat" class="btn btn--ghost">Eat with the seasons</a>
        </div>
        <ul class="hero__pills" data-reveal style="--delay: 400ms">
          <li>Seasonal &amp; local eating</li>
          <li>Spice &amp; produce guides</li>
          <li>Low-tox living</li>
        </ul>
      </div>

      <div class="hero__art" data-reveal style="--delay: 250ms" aria-hidden="true">
        <div class="hero__seal">
          <svg viewBox="0 0 200 200" class="hero__seal-text">
            <defs>
              <path id="circle" d="M100,100 m-74,0 a74,74 0 1,1 148,0 a74,74 0 1,1 -148,0" />
            </defs>
            <text>
              <textPath href="#circle" startOffset="0">
                · ROOTED IN TRADITION · GROWING WITH THE SEASONS
              </textPath>
            </text>
          </svg>
          <div class="hero__seal-mark"><BrandMark size={78} /></div>
        </div>
        <Botanical variant="sprig" width={70} class="hero__sprig hero__sprig--1" />
        <Botanical variant="sprig" width={54} class="hero__sprig hero__sprig--2" />
      </div>
    </div>
    <div class="hero__ticker" aria-hidden="true">
      <div class="hero__ticker-track">
        <span>Eat with the season</span><span aria-hidden="true">✦</span>
        <span>Breathe deeper</span><span aria-hidden="true">✦</span>
        <span>Cook with spices</span><span aria-hidden="true">✦</span>
        <span>Move every day</span><span aria-hidden="true">✦</span>
        <span>Choose low-tox</span><span aria-hidden="true">✦</span>
        <span>Rest in winter</span><span aria-hidden="true">✦</span>
        <span>Eat with the season</span><span aria-hidden="true">✦</span>
        <span>Breathe deeper</span><span aria-hidden="true">✦</span>
        <span>Cook with spices</span><span aria-hidden="true">✦</span>
        <span>Move every day</span><span aria-hidden="true">✦</span>
        <span>Choose low-tox</span><span aria-hidden="true">✦</span>
        <span>Rest in winter</span><span aria-hidden="true">✦</span>
      </div>
    </div>
  </section>

  <!-- ================= OUR STORY (banner intro) ================= -->
  <section class="story-banner" id="story">
    <div class="story-banner__glow" aria-hidden="true"></div>
    <div class="wrap-narrow story-banner__inner" data-reveal-scroll>
      <p class="eyebrow centered">Our Story</p>
      <h2>A movement back toward <em>older, wiser ways</em></h2>
      <p class="story-banner__text">
        We started Our Health Movement for one reason: modern wellness had become loud,
        expensive and complicated, while the wisdom that actually helps people feel well has
        been quietly sitting in ancient traditions all along.
      </p>
    </div>
  </section>

  <!-- ================= OUR STORY (full) ================= -->
  <section class="section story-full">
    <div class="wrap-narrow prose story-full__prose" data-reveal-scroll>
      <p class="story-full__standfirst">
        For most of human history, health wasn't a product. It was a way of living, woven
        into what you ate, how you moved, when you rested, and your place in the turning of
        the year.
      </p>
      <p>
        Somewhere along the way, we traded a lot of that for convenience. Food arrived
        stripped of its season. Movement became something you scheduled. And a growing haze of
        synthetic fragrances, plastics and additives settled quietly into daily life. We
        gained so much, and mislaid something, too.
      </p>
      <p>
        <strong>Our Health Movement is an attempt to gather it back up.</strong> We look to
        Ayurveda, Traditional Chinese Medicine, Yoga and other enduring traditions, not to
        romanticise the past, but because they hold genuinely useful, time-tested ideas about
        living well. Then we translate them into something you can actually do in a modern
        kitchen.
      </p>
      <p>
        That means seasonal, local eating. Cooking with spices that double as medicine.
        Moving in ways the body was built for, and breathing in ways that settle the nervous
        system. Clearing out the low-level toxic load of everyday life. And sharing all of it
        here, in plain language, free of fads and fear, so you can take what's useful and
        leave the rest.
      </p>
      <blockquote>
        The future of feeling well looks a lot like the past: seasonal, unhurried, and deeply
        connected to the natural world.
      </blockquote>
    </div>
  </section>

  <!-- ================= THE THREE TRADITIONS ================= -->
  <section class="section wisdom-block" id="wisdom">
    <div class="wrap">
      <header class="block-head" data-reveal-scroll>
        <div>
          <p class="eyebrow">Ancient Wisdom</p>
          <h2>Three rivers, one source</h2>
        </div>
        <p class="block-head__note">
          Ayurveda, Traditional Chinese Medicine and Yoga grew up worlds apart, yet they
          arrive at the same quiet truths, balance, breath, and living in step with nature.
        </p>
      </header>

      <div class="traditions">
        {
          wisdom.map((w, i) => (
            <a href={`/wisdom/${w.id}`} class={`tcard tcard--${w.data.accent}`} data-reveal-scroll style={`--delay: ${i * 90}ms`}>
              <span class="tcard__index">0{i + 1}</span>
              <h3>{w.data.title}</h3>
              <p class="tcard__tradition">{w.data.tradition}</p>
              <p class="tcard__summary">{w.data.summary}</p>
              <span class="tcard__origin">{w.data.origin} · {w.data.era}</span>
              <span class="link-arrow">Read more <span class="arrow">→</span></span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= SEASONAL SPOTLIGHT ================= -->
  <section class="section seasonal dark" id="seasonal">
    <div class="wrap">
      <header class="block-head block-head--light" data-reveal-scroll>
        <div>
          <p class="eyebrow">Eat with the Seasons</p>
          <h2 data-season-title>Right now, we're in season</h2>
        </div>
        <p class="block-head__note">
          The oldest nutrition advice there is: eat what's growing around you, now.
          <a href="/eat" data-season-link>See the full seasonal guide →</a>
        </p>
      </header>

      <div class="season-cards">
        {
          seasons.map((s) => (
            <article class={`scard scard--${s.accent}`} data-season-card={s.key} data-reveal-scroll>
              <div class="scard__top">
                <h3>{s.name}</h3>
                <span class="scard__now">In season now</span>
              </div>
              <p class="scard__tagline">{s.tagline}</p>
              <p class="scard__months">{s.months.north}</p>
              <ul class="scard__list">
                {[...s.vegetables.slice(0, 4), ...s.fruit.slice(0, 2)].map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <p class="scard__energy">
                <span>{s.element} element</span> · <span>{s.dosha}</span>
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= GUIDES ================= -->
  <section class="section guides-block">
    <div class="wrap">
      <header class="block-head" data-reveal-scroll>
        <div>
          <p class="eyebrow">Everyday Guides</p>
          <h2>Wisdom you can use tonight</h2>
        </div>
        <p class="block-head__note">
          Practical, no-nonsense guides, for the spice drawer, the veg box and the rest of
          the house.
        </p>
      </header>

      <div class="guide-routes">
        {
          guideRoutes.map((g, i) => (
            <a href={g.href} class={`gcard gcard--${g.accent}`} data-reveal-scroll style={`--delay: ${i * 90}ms`}>
              <div class="gcard__icon"><Botanical variant="branch" width={72} /></div>
              <h3>{g.label}</h3>
              <p>{g.blurb}</p>
              <span class="link-arrow">Open the guide <span class="arrow">→</span></span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= ABOUT ME ================= -->
  <section class="section aboutme" id="about-me">
    <div class="wrap aboutme__grid" data-reveal-scroll>
      <div class="aboutme__portrait">
        {/* To use a real photo, drop it in /public and replace this block with:
            <img src="/about-me.jpg" alt="A portrait of the founder" /> */}
        <div class="aboutme__frame" aria-hidden="true"><BrandMark size={76} /></div>
      </div>
      <div class="aboutme__copy">
        <p class="eyebrow">About Me</p>
        <h2>Why I started this</h2>
        <p>
          I came to this through medicine. As a medical student at Imperial, and now a student
          of integrative health at the National Centre for Integrative Medicine, I saw early
          how much the biomedical model can do, and where it struggles, especially with the
          long-term chronic conditions so many of us live with. What's needed isn't a
          replacement for that model, but a wider, holistic one to work alongside it.
        </p>
        <p>
          I've come to truly believe that health is made in our kitchens and our playgrounds:
          in how we eat, how we move, how we sleep, in our friendships, and in how we tend to
          our inner and outer worlds. Seen this way, health stops being something done to us
          and becomes something we can hold in our own hands and actively work towards. Mostly
          this is about prevention, the quiet, everyday choices that keep us well for the long
          run.
        </p>
        <p>
          My hope is to grow a community where wellbeing is simply woven into the everyday, not
          an add-on or a chore, but a natural, effortless and joyful way of being. For now, I'm
          starting with two things close to my heart: cooking with spices, and eating with the
          seasons. Begin there, and we'll grow from there together.
        </p>
        <div class="aboutme__links">
          <a href="/guides/spices" class="btn btn--terracotta">Explore the spice guides <span class="arrow">→</span></a>
          <a href="/eat" class="btn btn--ghost">Eat with the seasons</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= JOIN / INSTAGRAM ================= -->
  <section class="section insta" id="join">
    <div class="wrap insta__grid" data-reveal-scroll>
      <div class="insta__copy">
        <p class="eyebrow">Join the movement</p>
        <h2>Follow along on Instagram</h2>
        <p class="insta__text">
          Seasonal reminders, spice tips and low-tox swaps, shared through the week. Scan the
          code, or tap through, and come say hello.
        </p>
        <a
          href="https://www.instagram.com/our_healthmovement"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--terracotta"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
          </svg>
          @our_healthmovement
        </a>
      </div>

      <div class="insta__qr">
        <img
          src="/instagram-qr.svg"
          width="180"
          height="180"
          loading="lazy"
          alt="QR code to follow @our_healthmovement on Instagram"
        />
        <span class="insta__scan">Scan to follow</span>
      </div>
    </div>
  </section>

  <Newsletter />
</Layout>

<style>
  /* ---------------- hero ---------------- */
  .hero {
    position: relative;
    padding-top: clamp(2.5rem, 6vw, 5rem);
    overflow: hidden;
  }
  .hero__glow {
    position: absolute;
    top: -20%;
    right: -5%;
    width: 60%;
    aspect-ratio: 1;
    background: radial-gradient(circle, rgba(207, 147, 39, 0.22), transparent 62%);
    pointer-events: none;
    z-index: 0;
  }
  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }
  .hero h1 {
    font-size: var(--step-5);
    font-variation-settings: 'opsz' 144, 'SOFT' 20, 'wght' 400;
    margin-top: 1rem;
    letter-spacing: -0.02em;
  }
  .hero h1 em {
    font-style: italic;
    color: var(--terracotta);
    font-variation-settings: 'opsz' 144, 'SOFT' 80, 'wght' 380;
  }
  .hero__lede {
    margin-top: 1.5rem;
    max-width: 46ch;
    font-size: var(--step-1);
    color: var(--ink-2);
    line-height: 1.5;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .hero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    padding: 0;
    margin: 2.25rem 0 0;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .hero__pills li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 560;
  }
  .hero__pills li::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sage);
  }

  .hero__art {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 340px;
  }
  .hero__seal {
    position: relative;
    width: min(340px, 78%);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }
  .hero__seal-text {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: spin 46s linear infinite;
    fill: var(--sage-deep);
    font-family: var(--font-body);
    font-size: 11.2px;
    font-weight: 620;
    letter-spacing: 0.14em;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .hero__seal-mark {
    color: var(--terracotta);
    display: grid;
    place-items: center;
    width: 62%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, var(--paper-2), var(--paper-3));
    box-shadow: inset 0 2px 14px rgba(42, 32, 25, 0.12), 0 18px 40px -22px rgba(42, 32, 25, 0.5);
  }
  .hero__sprig {
    position: absolute;
    color: var(--sage);
    opacity: 0.75;
  }
  .hero__sprig--1 {
    top: -4%;
    left: 2%;
    transform: rotate(-18deg);
  }
  .hero__sprig--2 {
    bottom: -6%;
    right: 4%;
    transform: rotate(20deg) scaleX(-1);
  }

  .hero__ticker {
    position: relative;
    z-index: 1;
    border-block: 1px solid var(--line);
    padding-block: 0.9rem;
    overflow: hidden;
    background: color-mix(in srgb, var(--paper-2) 60%, transparent);
  }
  .hero__ticker-track {
    display: inline-flex;
    align-items: center;
    gap: 2.5rem;
    white-space: nowrap;
    animation: ticker 34s linear infinite;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--ink-2);
  }
  .hero__ticker-track span:nth-child(even) {
    color: var(--terracotta);
    font-style: normal;
  }
  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__ticker-track,
    .hero__seal-text {
      animation: none;
    }
  }

  /* ---------------- story banner ---------------- */
  .story-banner {
    position: relative;
    overflow: hidden;
    text-align: center;
    padding-block: clamp(3rem, 7vw, 5rem);
    background: linear-gradient(155deg, var(--clay) 0%, var(--terracotta) 45%, var(--terracotta-deep) 100%);
    color: #f7ecd9;
  }
  .story-banner__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(60% 90% at 85% -10%, rgba(207, 147, 39, 0.35), transparent 60%),
      radial-gradient(50% 80% at 0% 110%, rgba(42, 32, 25, 0.28), transparent 55%);
  }
  .story-banner__inner {
    position: relative;
  }
  .story-banner .eyebrow {
    color: #f4d8ac;
    justify-content: center;
  }
  .story-banner h2 {
    color: #fbf3e4;
    font-size: var(--step-3);
    margin-top: 0.6rem;
  }
  .story-banner h2 em {
    font-style: italic;
    color: #f6cf93;
  }
  .story-banner__text {
    margin: 1.25rem auto 0;
    max-width: 60ch;
    font-size: var(--step-1);
    line-height: 1.55;
    color: #f2e6cf;
  }
  /* ---------------- our story (full) ---------------- */
  .story-full {
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }
  .story-full__prose {
    max-width: 720px;
    font-size: var(--step-1);
  }
  .story-full__standfirst {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-variation-settings: 'opsz' 60, 'SOFT' 40, 'wght' 370;
    line-height: 1.3;
    color: var(--ink);
  }
  .story-full__prose strong {
    color: var(--terracotta-deep);
  }

  /* ---------------- shared block head ---------------- */
  .block-head {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.5rem 3rem;
    align-items: end;
    margin-bottom: clamp(2rem, 4vw, 3.25rem);
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  .block-head h2 {
    margin-top: 0.5rem;
  }
  .block-head__note {
    max-width: 38ch;
    color: var(--ink-2);
    font-size: var(--step-0);
    text-align: right;
  }
  .block-head--light {
    border-color: rgba(236, 228, 211, 0.2);
  }
  .block-head--light .block-head__note {
    color: #c8bda3;
  }
  @media (max-width: 720px) {
    .block-head {
      grid-template-columns: 1fr;
    }
    .block-head__note {
      text-align: left;
    }
  }

  /* ---------------- traditions ---------------- */
  .traditions {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .tcard {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.75rem 1.6rem 1.5rem;
    background: var(--paper-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--ink);
    position: relative;
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    border-top: 3px solid var(--accent, var(--terracotta));
  }
  .tcard--terracotta {
    --accent: var(--terracotta);
  }
  .tcard--sage {
    --accent: var(--sage-deep);
  }
  .tcard--ochre {
    --accent: var(--ochre-deep);
  }
  .tcard--clay {
    --accent: var(--clay);
  }
  .tcard:hover {
    transform: translateY(-4px);
    box-shadow: 0 22px 40px -26px rgba(42, 32, 25, 0.55);
    border-color: var(--accent);
  }
  .tcard__index {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-2);
    color: var(--accent);
    opacity: 0.85;
  }
  .tcard h3 {
    font-size: var(--step-2);
  }
  .tcard__tradition {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--ink-2);
    margin-top: -0.2rem;
  }
  .tcard__summary {
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.55;
    margin-top: 0.4rem;
  }
  .tcard__origin {
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-top: 0.75rem;
  }
  .tcard .link-arrow {
    margin-top: 1.1rem;
    color: var(--accent);
    border-color: currentColor;
  }

  /* ---------------- seasonal ---------------- */
  .seasonal {
    background: linear-gradient(165deg, var(--forest) 0%, var(--forest-2) 100%);
  }
  .season-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .scard {
    padding: 1.5rem 1.35rem;
    border-radius: var(--radius);
    background: rgba(244, 234, 214, 0.05);
    border: 1px solid rgba(236, 228, 211, 0.16);
    transition: transform 0.25s ease, background 0.25s ease, border-color 0.25s ease;
  }
  .scard__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .scard h3 {
    color: #f4ead6;
    font-size: var(--step-2);
  }
  .scard__now {
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 640;
    color: var(--forest);
    background: var(--ochre);
    padding: 0.25em 0.6em;
    border-radius: 100px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .scard__tagline {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--ochre);
