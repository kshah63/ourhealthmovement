  class={className}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  role="img"
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
>
  <g
    transform="translate(3 -3.5)"
    stroke="currentColor"
    stroke-width="1.9"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <!-- unfurling frond -->
