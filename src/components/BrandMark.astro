---
/**
 * Brand mark: an unfurling fern frond (koru / fiddlehead), one of the oldest
 * natural motifs for growth, renewal and ancient wisdom. Drawn as a single
 * logarithmic spiral with a stem and a growing tip.
 *
 * Uses currentColor so it inherits its colour from context (terracotta in the
 * header, ochre in the footer, etc.).
 */
interface Props {
  size?: number;
  class?: string;
  title?: string;
}
const { size = 40, class: className = '', title } = Astro.props;
---

